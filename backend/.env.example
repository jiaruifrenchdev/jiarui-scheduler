# ---- Backend environment variables ----
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Public anon key (safe for clients, used for RLS-scoped requests).
SUPABASE_ANON_KEY=

# Service-role key — FULL database access. Server-side ONLY. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret used to verify Supabase-issued access tokens (python-jose).
# Found in Supabase dashboard: Settings > API > JWT Secret.
SUPABASE_JWT_SECRET=

# Default timezone for scheduling (IANA name, e.g. America/Toronto).
TIMEZONE=America/Toronto

# Optional calendar clock override for testing. Mirror the frontend
# NEXT_PUBLIC_TEST_NOW so admin slot generation targets the same weeks the
# calendar shows. Leave empty (or set to null) in production.
TEST_NOW=

# Admin bootstrap credentials — read ONLY by scripts/seed_admin.py to create the
# single admin account. Never hardcoded, never committed (PROJECT_SPEC §2).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Email (Resend) ----
# API key from https://resend.com (Settings > API Keys). When empty, signup
# auto-confirms accounts and sends no email (local/dev fallback).
RESEND_API_KEY=
# From address. Use onboarding@resend.dev for testing (only delivers to the
# Resend account owner), or an address on a domain you've verified in Resend.
# A display name is allowed, e.g. "Jiarui French <noreply@yourdomain.com>".
EMAIL_FROM=noreply@jiarui-edu.com
# Public base URL of the frontend (no trailing slash) — used to build the
# confirmation link that lands on /auth/confirm.
FRONTEND_URL=http://localhost:3000
